  },
  "pll": {
    "kp": 2.5,
    "ki": 0.5,
    "clamp": 0.06,
    "offset_clamp": 0.012,
    "tau": 0.08,
    "dead": 0.002,
    "windup_guard": 0.02
  },
  "gap_db": 2.5,
  "style": 1.0,
  "humanize": {
    "enabled": true,
    "bias_a": -0.004,
    "bias_b": 0.003,
    "wobble": 0.0045,
    "tau_s": 0.35,
    "note": "each player drifts on its own; the PLL is what keeps them together"
  },
  "ensemble": {
    "note": "no conductor: two clocks, mutual PLL, balance and pedal follow the partner's numbers",
    "pll": "see pll",
    "gap_db": 2.5
  }
