{
  "bpm": 84,
  "beats_per_bar": 4,
  "key": "D minor",
  "root": 62,
  "midi_port": "loopMIDI Port 1",
  "score": {
    "a": "",
    "b": "",
    "a_track": 0,
    "b_track": 0
  },
  "leadership": [
    "A",
    "B"
  ],
  "reading": {
    "enabled": true,
    "out_dir": "readings",
    "max_chars": 2400,
    "pdf": true,
    "note": "stage 0: each player reads the whole score and writes an interpretation; the text is quoted back at every bar"
  },
  "models": {
    "A": {
      "name": "Player A (upper voice)",
      "base_url": "https://api.deepseek.com/v1",
      "model": "deepseek-chat",
      "api_key_env": "DEEPSEEK_API_KEY",
      "role": "upper voice, sings the line, phrases in long arcs",
      "lo": 55,
      "hi": 100,
      "style": "cantabile, breaths at phrase ends, rubato before the cadence",
      "timeout": 5.0
    },
    "B": {
      "name": "Player B (lower voice)",
      "base_url": "http://127.0.0.1:11434/v1",
      "model": "qwen2.5:14b-instruct",
      "api_key_env": "LOCAL_API_KEY",
      "role": "lower voice, holds the harmony and the floor",
      "lo": 24,
      "hi": 62,
      "style": "steady, grounds the tempo, answers the upper voice's gestures",
      "timeout": 5.0
    }
  },
  "params": {
    "reverb": {
      "cc": 20,
      "lo": 0,
      "hi": 127,
      "owner": "any",
      "rate_ms": 400,
      "ramp_ms": 300
    },
    "volume": {
      "cc": 7,
      "lo": 40,
      "hi": 110,
      "owner": "any",
      "rate_ms": 250,
      "ramp_ms": 200
    },
    "dynamic": {
      "cc": 21,
      "lo": 0,
      "hi": 127,
      "owner": "any",
      "rate_ms": 300,
      "ramp_ms": 250
    },
    "smooth_attack": {
      "cc": 22,
