  "notes": [
    {
      "movement": 4,
      "start": 113,
      "end": 120,
      "kind": "orchestration",
      "title": "第14变奏",
      "text": "第一、第二及低音长号进入宽阔二分、四分的和声句，巴松相应参与；中提琴、大提琴有八分分解活动。 E大调圣咏性音响；静态和声表层下仍有流动与变和弦。 “圣咏”描述宽阔和声节奏与音色，不等于已经识别某首教会旋律引文。"
    },
    {
      "movement": 4,
      "start": 121,
      "end": 128,
      "kind": "theme",
      "title": "第15变奏",
      "text": "长号句再展开，小号在121、123—124等参与；弦乐分解音型、下降连接，128出现减速编码。 大调光亮受半音变化侵蚀；128作为大段铰链而非简单稳定终止。"
    },
    {
      "movement": 4,
      "start": 129,
      "end": 136,
      "kind": "theme",
      "title": "第16变奏",
      "text": "3/4、一升号恢复；长笛八个附点二分完全复现原主题音高，管乐和声重现；弦乐随后插入。 具有再现性但和声低音改写；不是复制粘贴开头。 长笛恢复开头八音，但低音改变：具有再现功能，绝非照抄原先八小节。"
    },
    {
      "movement": 4,
      "start": 137,
      "end": 144,
      "kind": "theme",
      "title": "第17变奏",
      "text": "长笛、双簧管、巴松以四分为主，弦乐较长线条互答；铜管及低音提琴撤开。 主题重现后重新减轻，避免从此单向渐强。"
    },
    {
      "movement": 4,
      "start": 145,
      "end": 152,
      "kind": "theme",
      "title": "第18变奏",
      "text": "木管、弦乐四分与二分交错，低音巴松、圆号、长号加强；小号与定音鼓休止。 对位层增多，小调循环更具推动性。"
    },
    {
      "movement": 4,
      "start": 153,
      "end": 160,
      "kind": "theme",
      "title": "第19变奏",
      "text": "木管和上弦八分型对着低弦、长号四分层；圆号参与短动机。 节奏层级清晰，不同声部不是同一种切分的齐奏。"
    },
    {
      "movement": 4,
      "start": 161,
      "end": 168,
      "kind": "orchestration",
      "title": "第20变奏",
      "text": "上三组弦乐密集八分三连音；管乐有较长音及局部三连音，长号作重节点。 三分流动放大而拍号仍3/4，造成更高持续张力。"
    },
    {
      "movement": 4,
      "start": 169,
      "end": 176,
      "kind": "orchestration",
      "title": "第21变奏",
      "text": "第一小提琴、长笛等有三十二分急速音群；铜管、定音鼓与低音长音／四分形成块状支柱。 音群与柱式和声的冲撞把发展推向一处峰值。"
    },
    {
      "movement": 4,
      "start": 177,
      "end": 184,
      "kind": "theme",
      "title": "第22变奏",
      "text": "前一高潮的边界音后，管弦大量八分与三连分组；重铜管不再持续。 密度与音量重新分配，细分动力继续而重量减轻。"
    },
    {
      "movement": 4,
      "start": 185,
      "end": 192,
      "kind": "theme",
      "title": "第23变奏",
      "text": "木管和小提琴多三连音，圆号、小号和定音鼓突出较长节点；低弦八分推进。 在持续流动中组织新的属功能压力。"
    },
    {
      "movement": 4,
      "start": 193,
      "end": 200,
      "kind": "theme",
      "title": "第24变奏",
      "text": "圆号、小号、定音鼓四分／八分节型呼应第1变奏；中低弦三连音、长号每小节节点。 旧节奏材料的回忆与新的运动背景叠合，形成再现关联。"
    },
    {
      "movement": 4,
      "start": 201,
      "end": 208,
      "kind": "theme",
      "title": "第25变奏",
      "text": "长笛、单簧管、铜管的八分三连分组，对置双簧管、巴松和上弦四分层。 满编制中的节奏错层，避免把高潮解释成纯和弦齐奏。"
    },
    {
      "movement": 4,
      "start": 209,
      "end": 216,
      "kind": "theme",
      "title": "第26变奏",
      "text": "长笛和单簧管退场；双簧管、圆号留下旋律／和声，弦乐三连音活跃，低音较慢。 局部C自然音显著，色彩向降六级区域打开；仍须听作E小调总体中的游移。"
    },
    {
      "movement": 4,
      "start": 217,
      "end": 224,
      "kind": "orchestration",
      "title": "第27变奏",
      "text": "中提琴、大提琴八分流动；上弦和木管主要长音，铜管大体休止。 运动重心降低至中低音，形成尾声前最后的内向波段。"
    },
    {
      "movement": 4,
      "start": 225,
      "end": 232,
      "kind": "orchestration",
      "title": "第28变奏",
      "text": "第一小提琴、中提琴三连音；长笛、单簧管、巴松较疏的旋律回应；第二小提琴整段休止。 不对称配器产生透明而不安定的织体，和声方向渐收紧。"
    },
    {
      "movement": 4,
      "start": 233,
      "end": 240,
      "kind": "theme",
      "title": "第29变奏",
      "text": "前四小节弦乐分解短型，后四小节低弦退去；长笛达到高F♯，圆号与木管长音／四分接续。 空间突然抽空与高音停驻相结合，积累最后一次回旋力量。"
    },
    {
      "movement": 4,
      "start": 241,
      "end": 248,
      "kind": "theme",
      "title": "第30变奏",
      "text": "中提琴、木管和圆号八分和弦短击；外侧弦乐、低音巴松较强四分运动；长号休止。 八小节循环的最后完整核心；力度压力没有靠所有铜管同时叠满。"
    },
    {
      "movement": 4,
      "start": 249,
      "end": 252,
      "kind": "form",
      "title": "扩展",
      "text": "E中心持续音与弦乐切分延长，251—252低层出现C，252上方G升为G♯；减速。 周期外增四小节，准备进入新和声照明下的主题片段。 8+30×8+4+59=311。可把这四小节计作广义尾声，或第30变奏的扩展。"
    },
    {
      "movement": 4,
      "start": 253,
      "end": 311,
      "kind": "form",
      "title": "快速尾声",
      "text": "Più Allegro；管乐长音、弦乐急速分解与强奏交替，最终全乐队终止。 从规则变奏转为自由扩展、压缩与终止性强调。 Più Allegro后不再强行每八小节编号。m309—310属至主、m311再击，终止坚持e小调。"
    }
  ],
